  "item": [
    {
      "name": "Successful Sign In",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Assert status code is 422', function () {",
              "  pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test('Assert response contains email', function () {",
              "  const jsonData = pm.response.json();",
              "",
              "  pm.expect(jsonData.errors).to.have.property('email or password');",
              "});",
              "",
              "pm.test('Assert response contains empty bio', function () {",
              "  const jsonData = pm.response.json();",
              "",
              "  pm.expect(jsonData.user).to.be.undefined;",
              "});",
              "",
              "pm.test('Assert response contains empty image', function () {",
              "  const jsonData = pm.response.json();",
              "",
              "  pm.expect(jsonData.user).to.be.undefined;",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": {\n    \"email\": \"a.morgan@qa.team\",\n    \"password\": \"W@lterWh1te\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}users/login",
          "host": [
            "{{BASE_URL}}users"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
